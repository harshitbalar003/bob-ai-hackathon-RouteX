# ── Frontend ──────────────────────────────────────────────────────────────────
# Data source: 'mock' (default) reads local fixtures; 'api' hits the backend.
# No credentials required for mock mode — judges can run without this file.
VITE_DATA_SOURCE=mock

# Backend base URL — only needed when VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:8000/api

# ── Backend ───────────────────────────────────────────────────────────────────
# Database — SQLite by default, no setup required.
DATABASE_URL=sqlite+aiosqlite:///./supply_chain.db

# Engine configuration
NOMINAL_SENSOR_INTERVAL_MINUTES=5
GAP_MULTIPLIER=3
EXCURSION_DEBOUNCE_MINUTES=10
STUCK_VALUE_MINUTES=60

# Priority queue weights (0–1; must not sum to >1 within a category)
PQ_WEIGHT_SEVERITY=0.45
PQ_WEIGHT_ACTIONABILITY=0.25
PQ_WEIGHT_VALUE=0.20
PQ_WEIGHT_ETA_SLIP=0.30
PQ_WEIGHT_WASTE=0.55
PQ_WEIGHT_MATCH=0.45

# Feature flags
FEATURE_SSE=false

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing key — change before deploying anywhere public.
# The app logs a warning when this development default is in use.
SESSION_SECRET=dev-secret-change-in-prod-2025x!

# ── watsonx.ai (optional — system runs fully without these) ───────────────────
# NEVER commit a real API key. Security team deactivates accounts on detection.
WATSONX_ENABLED=false
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=your-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
WATSONX_MAX_TOKENS=512
WATSONX_TIMEOUT_SECONDS=30
